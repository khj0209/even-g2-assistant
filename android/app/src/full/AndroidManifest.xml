<?xml version="1.0" encoding="utf-8"?>
<!--
  The "full" build adds what's-playing support. Notification access is what lets the app read other
  apps' media sessions; Play Protect blocks sideloading (from a browser or file manager) any app that
  declares it, so it lives only in this build. Install it with adb or with Play Protect paused.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="G2 Context 재생 정보"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
