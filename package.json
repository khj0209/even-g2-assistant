{
  "name": "even-g2-assistant",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "description": "AI assistant (pixel baby bear + Claude) for Even Realities G2 glasses",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qr": "evenhub qr --port 5173",
    "sim": "evenhub-simulator http://localhost:5173/",
    "pack": "npm run build && evenhub pack app.json dist -o g2-assistant.ehpk",
    "version": "node scripts/version.mjs sync && git add app.json"
  },
  "engines": {
    "node": "^20.17.0 || >=22.13.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
